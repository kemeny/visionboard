          }
        }
      }
    },
    "Your account and the backup of your board list are deleted from our server. You can also delete every board's cloud copy, which stops sync on your other devices. Your boards stay on this iPhone either way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran de nuestro servidor tu cuenta y el respaldo de tu lista de tableros. También puedes borrar la copia en la nube de cada tablero, lo que detiene la sincronización en tus otros dispositivos. En ambos casos, tus tableros se quedan en este iPhone."
          }
        }
      }
    },
    "Your account was deleted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta fue borrada."
