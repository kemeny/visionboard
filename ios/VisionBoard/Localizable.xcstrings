          "stringUnit": {
            "state": "translated",
            "value": "Tu tablero te extraña"
          }
        }
      }
    },
    "Your board stays on this iPhone, but every other device stops syncing and its photos are removed from the cloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tablero queda en este iPhone, pero los demás dispositivos dejan de sincronizar y sus fotos se borran de la nube."
